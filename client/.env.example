# Base URL the browser uses for API calls.
# "/api" goes through the Vite dev/preview proxy (no CORS needed).
# For a separately hosted API use an absolute URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev/preview proxy target for /api (the Express server). Not exposed to the browser.
API_PROXY_TARGET=http://localhost:5000
