{
  "name": "team-task-bug-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Team Task & Bug Tracker — MERN + TypeScript monorepo",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client --if-present",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
